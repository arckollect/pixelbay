<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026. All rights reserved.</string>

	<!--
	Sparkle auto-update configuration. SUFeedURL is a placeholder until the
	real appcast host is provisioned pre-launch; SUPublicEDKey is empty until
	the EdDSA signing key is generated for the first signed release. Sparkle
	is opted-in here so v0.1 beta builds can self-update once the keys land —
	retrofitting auto-update later strands beta users with no upgrade path.
	-->
	<key>SUFeedURL</key>
	<string>https://pixelbay.example.com/appcast.xml</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUPublicEDKey</key>
	<string></string>

	<!--
	Permission usage strings. These are MANDATORY: missing strings cause
	silent TCC denials in notarized release builds even though debug builds
	on the dev machine appear to work fine. Test on a fresh user account.
	NSScreenCaptureUsageDescription is read by macOS 15+; on macOS 14 the
	Screen Recording prompt uses a system-default string but we set it now
	for forward compatibility.
	-->
	<key>NSCameraUsageDescription</key>
	<string>Pixelbay uses the camera to record your webcam alongside the screen during recordings.</string>

	<!--
	Disable Continuity Camera "Reactions" (the gesture-triggered hearts /
	confetti / fireworks / balloons / lasers overlays) by default for our
	camera use. Without this, a hand gesture mid-recording bakes a reaction
	effect into the webcam track — unwanted for a screen recorder. Users can
	still re-enable reactions from Control Center if they really want them.
	-->
	<key>NSCameraReactionEffectGesturesEnabledDefault</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Pixelbay uses the microphone to record your voice alongside the screen during recordings and voiceovers.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Pixelbay records the contents of your screen so you can share or edit a video of your work.</string>

	<!--
	Document type declaration for the .pixelbay project bundle. LSTypeIsPackage
	makes Finder treat the directory as an opaque file. The capture pipeline
	streams source files into this bundle directly during recording; see
	PixelbayCore.ProjectBundle for the on-disk layout.
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Pixelbay Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.pixelbay.project</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.pixelbay.project</string>
			<key>UTTypeDescription</key>
			<string>Pixelbay Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
				<string>public.composite-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pixelbay</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
